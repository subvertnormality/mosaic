diff --git a/lib/clock/m_clock.lua b/lib/clock/m_clock.lua
index fed71b9..9ce5e45 100644
--- a/lib/clock/m_clock.lua
+++ b/lib/clock/m_clock.lua
@@ -8,6 +8,7 @@ clock_lattice = {}
 local playing = false
 local master_clock
 local midi_clock_init
+local pending_master_start
 local first_run = true
 
 local ppqn = 96
@@ -829,13 +830,35 @@ function m_clock:start(from_external_transport)
   -- against an already-running MIDI clock retains its own starting phase.
   clock_lattice.sync_to_external = from_external_transport == true
   clock_lattice.external_clock_active = function() return params:get("clock_source") == 2 end
-  -- The onset callback prepares the resolved first step before its note.
-  clock_lattice:start()
+  -- Start must reach receivers before the first note. When forwarding the
+  -- native clock, begin on its next 24-PPQN edge instead of the button phase.
   m_midi.start()
+  local sends_clock = false
+  for port = 1, #midi.vports do
+    if params:get("clock_midi_out_" .. port) == 1 then sends_clock = true end
+  end
+  if sends_clock and not from_external_transport and not clock_lattice.enabled then
+    local target_lattice = clock_lattice
+    local origin = (math.floor(clock.get_beats() * 24) + 1) / 24
+    pending_master_start = clock.run(function()
+      clock.sync(1 / 24)
+      pending_master_start = nil
+      if playing and clock_lattice == target_lattice then
+        target_lattice.sync_origin = origin
+        target_lattice:start()
+      end
+    end)
+  else
+    clock_lattice:start()
+  end
        
 end
 
 function m_clock:stop(send_transport)
+  if pending_master_start then
+    clock.cancel(pending_master_start)
+    pending_master_start = nil
+  end
 
   playing = false
   first_run = true
