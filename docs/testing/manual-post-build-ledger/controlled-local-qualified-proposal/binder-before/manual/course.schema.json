{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "summary",
    "project",
    "learning_path"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "output",
        "incoming_state",
        "capture_status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "output": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "incoming_state": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "capture_status": {
          "enum": [
            "pending",
            "verified"
          ]
        }
      }
    },
    "learning_path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "goal",
          "prerequisite",
          "outgoing_state",
          "recovery",
          "stages"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "prerequisite": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "outgoing_state": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "recovery": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "stages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "goal",
                "action",
                "result",
                "binding"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "goal": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "action": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "result": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "binding": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "scene",
                    "step"
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "pending",
                        "verified"
                      ]
                    },
                    "scene": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "minLength": 1
                    },
                    "step": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "minLength": 1
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "status": {
                            "const": "verified"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "scene": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          },
                          "step": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "scene": {
                            "type": "null"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "step": {
                            "type": "null"
                          }
                        }
                      },
                      "else": {
                        "properties": {
                          "step": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mosaic continuing musical course"
}
