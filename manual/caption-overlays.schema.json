{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Compiled manual caption overlays",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "overlays"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "overlays": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scene_id",
          "step_id",
          "caption",
          "baseline_caption",
          "contract_sha256"
        ],
        "properties": {
          "scene_id": {
            "type": "string",
            "minLength": 1
          },
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "caption": {
            "type": "string",
            "minLength": 1
          },
          "baseline_caption": {
            "type": "string",
            "minLength": 1
          },
          "contract_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
