{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recordings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "recordings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "purpose",
          "starting_point",
          "lesson_relations",
          "build_steps",
          "listen_for",
          "restore_steps",
          "limits"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "starting_point": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "lesson_relations": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "feature_id",
                    "lesson_id",
                    "relationship",
                    "explanation"
                  ],
                  "properties": {
                    "kind": {
                      "const": "feature-lesson"
                    },
                    "feature_id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "lesson_id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "relationship": {
                      "enum": [
                        "exact",
                        "contextual"
                      ]
                    },
                    "explanation": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "course_stage_id",
                    "relationship",
                    "explanation"
                  ],
                  "properties": {
                    "kind": {
                      "const": "course-stage"
                    },
                    "course_stage_id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "relationship": {
                      "enum": [
                        "exact",
                        "contextual"
                      ]
                    },
                    "explanation": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "feature_id",
                    "recipe_index",
                    "recipe_title",
                    "relationship",
                    "explanation"
                  ],
                  "properties": {
                    "kind": {
                      "const": "recipe"
                    },
                    "feature_id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "recipe_index": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "recipe_title": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "relationship": {
                      "enum": [
                        "exact",
                        "contextual"
                      ]
                    },
                    "explanation": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  }
                }
              ]
            }
          },
          "build_steps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "listen_for": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "restore_steps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "limits": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    }
  }
}
