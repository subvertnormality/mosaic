{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mosaic review pilot authoring data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feature",
    "scenes",
    "audio"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "feature": {
      "type": "object",
      "required": [
        "id",
        "title",
        "audience",
        "summary",
        "prose",
        "musical_use",
        "related",
        "sources",
        "controls",
        "details",
        "recipes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "enum": [
            "beginner",
            "intermediate",
            "expert",
            "all"
          ]
        },
        "summary": {
          "type": "string"
        },
        "prose": {
          "type": "string"
        },
        "musical_use": {
          "type": "string"
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "object"
        },
        "controls": {
          "type": "array"
        },
        "details": {
          "type": "array"
        },
        "recipes": {
          "type": "array"
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "behaviour_case",
          "setup",
          "steps"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string"
          },
          "behaviour_case": {
            "type": "string",
            "pattern": "^M-[A-Z0-9-]+$"
          },
          "setup": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fixture",
              "seed",
              "voices"
            ],
            "properties": {
              "fixture": {
                "enum": [
                  "four-note-pattern",
                  "four-note-eight-step"
                ]
              },
              "seed": {
                "const": 42
              },
              "voices": {
                "type": "object"
              }
            }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "caption",
                "inputs",
                "expect",
                "citation"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "caption": {
                  "type": "string",
                  "minLength": 1
                },
                "citation": {
                  "type": "string",
                  "pattern": "^(README.md#|characterisation:)"
                },
                "inputs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "type": {
                        "enum": [
                          "grid",
                          "key",
                          "enc",
                          "wait",
                          "play",
                          "stop"
                        ]
                      },
                      "n": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 3
                      },
                      "x": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 16
                      },
                      "y": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 8
                      },
                      "state": {
                        "type": "integer",
                        "enum": [
                          0,
                          1
                        ]
                      },
                      "delta": {
                        "type": "integer",
                        "minimum": -128,
                        "maximum": 128
                      },
                      "seconds": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "type": {
                              "const": "grid"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "x",
                            "y",
                            "state"
                          ]
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "type": {
                              "const": "key"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "n"
                          ]
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "type": {
                              "const": "enc"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "n",
                            "delta"
                          ]
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "type": {
                              "const": "wait"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "seconds"
                          ]
                        }
                      }
                    ]
                  }
                },
                "expect": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": false,
                  "properties": {
                    "screen": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2
                      }
                    },
                    "midi_phrase": {
                      "type": "array",
                      "minItems": 1
                    },
                    "durations": {
                      "type": "array"
                    },
                    "positions": {
                      "type": "array"
                    },
                    "cycle_steps": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 64
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "required": [
        "title",
        "profile",
        "bars",
        "bpm",
        "files",
        "tracks",
        "description"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "profile": {
          "const": "manual-duo"
        },
        "bars": {
          "type": "integer",
          "minimum": 4,
          "maximum": 16
        },
        "bpm": {
          "type": "number",
          "minimum": 30,
          "maximum": 240
        },
        "files": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "tracks": {
          "type": "array",
          "minItems": 2
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
